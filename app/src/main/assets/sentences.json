    {
     "jp": "こんばんは。",
     "romaji": "Konbanwa.",
     "bn": "শুভ সন্ধ্যা।",
     "en": "Good evening."
    },
    {
     "jp": "おやすみなさい。",
     "romaji": "Oyasuminasai.",
     "bn": "শুভ রাত্রি।",
     "en": "Good night."
    },
    {
     "jp": "おげんきですか。",
     "romaji": "O-genki desu ka.",
     "bn": "কেমন আছেন?",
     "en": "How are you?"
    },
    {
     "jp": "げんきです。ありがとうございます。",
     "romaji": "Genki desu. Arigatou gozaimasu.",
     "bn": "ভালো আছি, ধন্যবাদ।",
     "en": "I'm fine, thank you."
    },
    {
     "jp": "いってきます。",
     "romaji": "Ittekimasu.",
     "bn": "যাচ্ছি (বাড়ি থেকে বের হওয়ার সময়)।",
     "en": "I'm leaving (said when leaving home)."
    },
    {
     "jp": "いってらっしゃい。",
     "romaji": "Itterasshai.",
     "bn": "ঘুরে এসো / সাবধানে যেও।",
     "en": "Take care / See you later."
    },
    {
     "jp": "ただいま。",
     "romaji": "Tadaima.",
     "bn": "ফিরলাম (বাড়ি ফিরে)।",
     "en": "I'm home."
    },
    {
     "jp": "おかえりなさい。",
     "romaji": "Okaerinasai.",
     "bn": "ফিরে এলে, স্বাগতম।",
     "en": "Welcome back."
    },
    {
     "jp": "また あした。",
     "romaji": "Mata ashita.",
     "bn": "কাল আবার দেখা হবে।",
     "en": "See you tomorrow."
    },
    {
     "jp": "さようなら。",
     "romaji": "Sayounara.",
     "bn": "বিদায়।",
     "en": "Goodbye."
    }
   ]
  },
